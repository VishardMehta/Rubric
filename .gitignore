# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
*.tsbuildinfo

# Recorded fixtures containing real API responses go in tests/cassettes and
# ARE committed on purpose (DEMO_MODE needs them). Only ad hoc local capture
# output is ignored here.
backend/tests/cassettes/.local/

# OS
.DS_Store

# Editors
# .vscode/settings.json is committed on purpose: it pins the Python
# interpreter to backend/.venv. Without it editors resolve against the
# system Python and report every third-party import as missing.
.vscode/*
!.vscode/settings.json
.idea/

# Logs
*.log

# --- Not shipped -----------------------------------------------------------
#
# Real candidate documents. Three of these are actual resumes belonging to
# real people; they are development inputs, not sample data, and must not
# be published. They stay on disk for local testing.
Demofiles/

# Client-facing and internal build notes. Nothing here is needed to run the
# project, and PROJECT.md carries commercial terms.
PROJECT.md
CLAUDE.md
DESIGN.md
docs/implementation-plan.md
docs/prior-art.md
docs/reference/

# Demo rows naming real people, and a shipped database should start empty
# anyway. Post a job and apply to populate it.
database/seed.sql
