# Copy this file to .env and fill in real values. Never commit .env.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY: Supabase project settings, API.
# The service_role key bypasses row level security. Backend only. Never the
# frontend, never committed, not even temporarily.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# aistudio.google.com, free tier.
GEMINI_API_KEY=

# console.groq.com, free tier.
GROQ_API_KEY=

# 1 to replay recorded cassettes instead of calling Gemini, Groq or Supabase.
# See backend.md section 8. Unset or 0 for live calls.
DEMO_MODE=0

# 1 to let ANY email and ANY password sign in, creating the account on the
# spot, and to let the candidate portal fall back to showing every
# application when the address it is given has none.
#
# This is a real authentication bypass. It exists for walking a client
# through the product without stopping to remember a password, and it is
# safe only because this project is localhost only with no deployment.
# Separate from DEMO_MODE, which swaps the database for an in-memory store.
# Unset or 0 for real logins.
DEMO_AUTH=0
